    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "PROFILE = [\n    \"software engineer\",\n    \"software developer\",\n    \"backend engineer\",\n    \"back-end engineer\",\n    \"backend developer\",\n    \"back-end developer\",\n    \"python engineer\",\n    \"python developer\",\n    \"fullstack engineer\",\n    \"full-stack engineer\",\n    \"fullstack developer\",\n    \"full-stack developer\",\n]\n\nfor item in _items:\n    title = item[\"json\"][\"title\"].lower()\n\n    item[\"json\"][\"is_job_matching_profile\"]  = any(k in title for k in PROFILE)\n\nreturn _items"
      },
