    {
      "parameters": {
        "jsCode": "const jobs = $input.all();\n\nif (jobs.length === 0) {\n  return [];\n}\n\nlet html = `\n<h2>🔍 ${jobs.length} nouvelle(s) offre(s)</h2>\n<p>Voici les offres correspondant à ton profil.</p>\n`;\n\nfor (const job of jobs) {\n  html += `\n  <div style=\"\n    border:1px solid #ddd;\n    border-radius:8px;\n    padding:16px;\n    margin-bottom:16px;\n  \">\n    <h3 style=\"margin-top:0\">${job.json.title}</h3>\n\n    <p>\n      <strong>${job.json.company}</strong><br>\n      📍 ${job.json.location}<br>\n      🏠 ${job.json.remote_policy}<br>\n      💼 ${job.json.employment_type}\n    </p>\n\n    <p>\n      <a href=\"${job.json.url}\">Voir l'offre →</a>\n    </p>\n  </div>\n  `;\n}\n\nreturn [\n  {\n    json: {\n      subject: `🔍 ${jobs.length} nouvelle(s) offre(s) trouvée(s)`,\n      html,\n    },\n  },\n];"
      },
