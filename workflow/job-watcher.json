    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "for item in _items:\n    job = item[\"json\"]\n\n    # HTML de l'annonce\n    html = job.get(\"content_html\", \"\")\n    lower = html.lower()\n\n    # Company\n    company = \"Unknown\"\n    try:\n        company = job[\"_jobposting\"][\"hiringOrganization\"][\"name\"]\n    except:\n        pass\n\n    # Location\n    location = \"Unknown\"\n    try:\n        location = job[\"_jobposting\"][\"jobLocation\"][0][\"address\"][\"addressLocality\"]\n    except:\n        pass\n\n    # Remote policy\n    remote_policy = \"Unknown\"\n\n    if \"100 %\" in lower or \"100%\" in lower:\n        remote_policy = \"Remote\"\n    elif \"télétravail partiel\" in lower:\n        remote_policy = \"Hybrid\"\n    elif \"dans nos locaux\" in lower:\n        remote_policy = \"Onsite\"\n\n    # Employment type\n    employment_type = \"Unknown\"\n\n    if \"Type d'emploi :\" in html:\n        employment_type = html.split(\"Type d'emploi :\", 1)[1]\n        employment_type = employment_type.split(\"</p>\", 1)[0]\n        employment_type = employment_type.strip()\n\n    item[\"json\"] = {\n        \"company\": company,\n        \"title\": job.get(\"title\"),\n        \"location\": location,\n        \"remote_policy\": remote_policy,\n        \"employment_type\": employment_type,\n        \"url\": job.get(\"url\"),\n        \"published_at\": job.get(\"date_published\"),\n        \"source\": \"teamtailor\",\n    }\n\nreturn _items"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
